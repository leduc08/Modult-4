# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị.
# File .env KHÔNG được đẩy lên GitHub.

# Đăng nhập bằng Google — xem SETUP_GOOGLE_LOGIN.md
GOOGLE_CLIENT_ID=

# Đọc hóa đơn bằng Gemini — mỗi người tự tạo key tại https://aistudio.google.com
GEMINI_API_KEY=

# Travel assistant: server-side only. Never expose real keys in frontend code.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# disabled saves reasoning tokens; enabled turns thinking on.
DEEPSEEK_THINKING=disabled
APP_URL=http://localhost:3000

# Supabase project settings. Find these in Project Settings > API Keys.
SUPABASE_URL=
# Safe to expose only when your tables have correct RLS policies.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backend/import scripts only. Never use a VITE_ prefix for this key.
SUPABASE_SECRET_KEY=

# Optional web-search fallback when Supabase has no relevant knowledge.
TAVILY_API_KEY=
